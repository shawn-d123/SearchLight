# secrets
.env

# Large regenerable intermediates, rebuilt by:
#   python prep/fetch_terrain.py all
# See prep/STATUS.md. NOTE: gitignore has no trailing comments -- a pattern
# and a comment on the same line makes the comment part of the pattern.
data/trails.graphml
data/dem.tif
data/_*.npy
prep/mapscore/
prep/.osm_cache/

# The four worker arrays ARE committed -- Person B bakes them into the
# Daytona snapshot: elevation.npy slope.npy trail_dist.npy water_dist.npy

# Frame-rate stress fixture, 12.3 MB in two places. Regenerates in ~10 s:
#   python prep/make_mocks.py --stress
mocks/trajectories_12k.json
frontend/public/mocks/trajectories_12k.json

# NOTE: frontend/public/tiles/ IS committed on purpose -- 189 cached terrain
# tiles, 21 MB. Regenerating them needs the network, which is exactly the
# failure we are insuring against. See prep/cache_tiles.py.

# python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# node
node_modules/
.next/
out/
next-env.d.ts
.DS_Store

# Staging dir for Daytona snapshot builds (see prep/TIMINGS.md).

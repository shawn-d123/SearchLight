# Secrets. See .env.example for what each key is for.
.env

# Large regenerable intermediates, rebuilt by:
#   python pipeline/fetch_terrain.py all
# NOTE: gitignore has no trailing comments -- a pattern and a comment on the
# same line makes the comment part of the pattern.
data/trails.graphml
data/dem.tif
data/_*.npy
pipeline/mapscore/
pipeline/.osm_cache/

# The four worker arrays ARE committed. They are baked into the Daytona
# snapshot and mmapped by the local fleet:
#   elevation.npy slope.npy trail_dist.npy water_dist.npy

# Frame-rate stress fixture, 12.3 MB in two places. Regenerates in ~10 s:
#   python pipeline/make_fixtures.py --stress
fixtures/trajectories_12k.json
web/public/fixtures/trajectories_12k.json

# NOTE: web/public/tiles/ IS committed on purpose -- 1,060 cached terrain
# tiles. Regenerating them needs the network, which is exactly the failure
# this insures against. See web/scripts/cache-tiles.mjs.

# python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# node
node_modules/
.next/
out/
next-env.d.ts
.DS_Store

# Written and re-added by `next dev` (node_modules/next/dist/server/lib/
# generate-agent-files.js). Not ours, and both regenerate on every dev start.
AGENTS.md
CLAUDE.md

# Staging dir for Daytona snapshot builds.
# Regenerate: cp data/*.npy data/meta.json _snapdata/
_snapdata/

# pipeline/tune_evidence.py's captured run (12 MB). Regenerate, do not commit.
pipeline/_batches.json
